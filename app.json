{
  "expo": {
    "name": "Suproan Enterprises",
    "slug": "suproan-invoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "suproan",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B3A1F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.supraon.invoice"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B3A1F"
      },
      "package": "com.supraon.invoice",
      "versionCode": 1,
      "buildType": "apk"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6B3A1F"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
